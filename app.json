{
  "expo": {
    "name": "sue",
    "slug": "sue",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sue",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alliancetech.com",
      "deploymentTarget": "15.0",
      "associatedDomains": [
        "applinks:sue-app.fr"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "SUE utilise vos contacts pour vous aider à trouver vos amis qui utilisent déjà l'application et à les inviter à vos sessions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.alliancetech.com",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D4FC79",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#D4FC79"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D4FC79"
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "SUE utilise vos contacts pour vous aider à trouver vos amis qui utilisent déjà l'application et à les inviter à vos sessions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SUE accède à vos photos pour choisir votre photo de profil.",
          "cameraPermission": "SUE accède à votre caméra pour prendre votre photo de profil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b831c3a-2180-4050-b751-7e5248737d95"
      }
    },
    "owner": "alliancetech",
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1b831c3a-2180-4050-b751-7e5248737d95"
    }
  }
}